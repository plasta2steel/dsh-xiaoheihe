{
  "name": "heybox",
  "version": "0.3.8",
  "description": "小黑盒论坛分区(HeyBox):在 DSH Web 会话右侧开一个可伸缩的小黑盒(xiaoheihe.cn)客户端分区 — 推荐/板块/收藏/搜索/帖子详情与评论/消息提醒,照搬 WenfuRainbow/heybox 的交互与接口。/ A xiaoheihe.cn forum pane docked beside the DSH Web conversation, ported from WenfuRainbow/heybox.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "xiaoheihe",
    "heybox",
    "小黑盒",
    "forum",
    "web",
    "client"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/bomcheck.mjs && node --check lib/index.js && node --check lib/client.js",
    "test": "node tests/rewrite.test.mjs && node tests/client.smoke.mjs",
    "prepublishOnly": "npm run check && npm test"
  }
}
